<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BimAgent</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(RevitInstallPath)' == ''">
    <RevitInstallPath>C:\Program Files\Autodesk\Revit 2026</RevitInstallPath>
  </PropertyGroup>
</Project>
